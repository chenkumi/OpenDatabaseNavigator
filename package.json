{
  "name": "database-workspace",
  "version": "0.1.0",
  "description": "Desktop database client for humans and AI agents, with a built-in local MCP server",
  "license": "MIT",
  "keywords": [
    "database",
    "sql",
    "sqlite",
    "postgresql",
    "mysql",
    "sqlserver",
    "redis",
    "electron",
    "mcp",
    "ai-agent"
  ],
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "typecheck": "tsc --noEmit",
    "check:secure-storage": "node scripts/check-secure-storage.mjs",
    "check:linux-artifacts": "node scripts/check-linux-artifacts.mjs",
    "test": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "integration:up": "node scripts/integration-services.mjs up",
    "integration:stop": "node scripts/integration-services.mjs stop",
    "test:desktop:agent": "npm run build && node scripts/smoke-agent-redis.mjs",
    "test:desktop:scopes": "npm run build && node scripts/smoke-scopes.mjs",
    "test:desktop:sqlserver-auth": "npm run build && node scripts/smoke-sqlserver-auth.mjs",
    "test:desktop": "npm run build && node scripts/smoke-electron.mjs",
    "test:desktop:all": "node scripts/run-smokes.mjs",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "test:packaged:credentials": "node scripts/smoke-packaged-credentials.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder --dir",
    "test:desktop:objects": "npm run build && node scripts/smoke-object-tabs.mjs",
    "test:desktop:structure": "npm run build && node scripts/smoke-structure.mjs",
    "test:desktop:ui": "npm run build && node scripts/smoke-ui-iteration.mjs",
    "test:desktop:ui-design": "npm run build && node scripts/smoke-ui-design.mjs",
    "test:desktop:result-tools": "npm run build && node scripts/smoke-result-tools.mjs",
    "test:desktop:review": "npm run build && node scripts/smoke-review-fixes.mjs",
    "test:sybase": "node scripts/test-sybase.mjs",
    "test:desktop:sybase": "npm run build && node scripts/smoke-sybase.mjs",
    "test:desktop:rename": "npm run build && node scripts/smoke-rename-objects.mjs",
    "test:desktop:connection-options": "npm run build && node scripts/smoke-connection-options.mjs",
    "test:desktop:constraints": "npm run build && node scripts/smoke-constraints.mjs",
    "test:desktop:structure-properties": "npm run build && node scripts/smoke-structure-properties.mjs",
    "test:desktop:generated-columns": "npm run build && node scripts/smoke-generated-columns.mjs",
    "test:desktop:view-options": "npm run build && node scripts/smoke-view-options.mjs",
    "test:desktop:index-options": "npm run build && node scripts/smoke-index-options.mjs",
    "test:desktop:database-properties": "npm run build && node scripts/smoke-database-properties.mjs",
    "test:desktop:sql-file": "npm run build && node scripts/smoke-sql-file.mjs",
    "test:desktop:sql-export": "npm run build && node scripts/smoke-sql-export.mjs",
    "test:desktop:mysql-export": "npm run build && node scripts/smoke-mysql-export.mjs",
    "test:desktop:postgres-export": "npm run build && node scripts/smoke-postgres-export.mjs",
    "test:desktop:sqlserver-export": "npm run build && node scripts/smoke-sqlserver-export.mjs"
  },
  "build": {
    "appId": "dev.database.workspace",
    "productName": "Database Workspace",
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "appImage": {
      "executableArgs": []
    },
    "asarUnpack": [
      "node_modules/msnodesqlv8/**"
    ],
    "files": [
      "dist/**",
      "package.json",
      "licenses/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iconv-lite": "0.7.3",
    "lucide-react": "^1.49.0",
    "monaco-editor": "^0.57.0",
    "mssql": "12.7.2",
    "mysql2": "^3.24.5",
    "node-sql-parser": "^5.4.0",
    "pg": "8.23.0",
    "pg-query-stream": "^4.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "redis": "^6.3.0",
    "tailwind-merge": "^3.7.0",
    "tedious": "20.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "msnodesqlv8": "5.5.0"
  }
}
